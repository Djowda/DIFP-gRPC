<?xml version="1.0" encoding="utf-8"?>
<!--
  DIFP Test Client Layout
  File: res/layout/activity_difp_test.xml
  Wire this layout to MainActivity via setContentView(R.layout.activity_difp_test)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:spacing="8dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DIFP Node — Test Client"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:layout_marginBottom="12dp"/>

        <!-- ── SERVER CONNECTION ───────────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SERVER" android:textSize="11sp" android:textColor="#888"
            android:textStyle="bold" android:layout_marginTop="4dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="4dp">

            <EditText
                android:id="@+id/et_host"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:hint="Host"
                android:text="10.0.2.2"
                android:inputType="text"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/et_port"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Port"
                android:text="50051"
                android:inputType="number"/>
        </LinearLayout>

        <!-- ── LOCATION ────────────────────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LOCATION (lat / lng)" android:textSize="11sp" android:textColor="#888"
            android:textStyle="bold" android:layout_marginTop="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="4dp">

            <EditText
                android:id="@+id/et_latitude"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Latitude"
                android:text="36.7538"
                android:inputType="numberDecimal|numberSigned"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/et_longitude"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Longitude"
                android:text="3.0588"
                android:inputType="numberDecimal|numberSigned"/>
        </LinearLayout>

        <!-- ── COMPONENT ───────────────────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="COMPONENT" android:textSize="11sp" android:textColor="#888"
            android:textStyle="bold" android:layout_marginTop="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="4dp">

            <EditText
                android:id="@+id/et_comp_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Type (f/s/r/u…)"
                android:text="f"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/et_comp_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:hint="Component Name"
                android:text="Test Farm"/>
        </LinearLayout>

        <!-- ── FLOW SELECTOR ───────────────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="FLOW" android:textSize="11sp" android:textColor="#888"
            android:textStyle="bold" android:layout_marginTop="8dp"/>

        <Spinner
            android:id="@+id/sp_flow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- ── RUN BUTTON ──────────────────────── -->
        <Button
            android:id="@+id/btn_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run Flow"
            android:layout_marginBottom="12dp"/>

        <!-- ── RESULT ──────────────────────────── -->
        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#1A1A2E"
            android:textColor="#E0E0E0"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:text="Select a flow and tap Run…"/>

    </LinearLayout>
</ScrollView>
